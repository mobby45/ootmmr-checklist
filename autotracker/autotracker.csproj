<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>autotracker</AssemblyName>
    <RootNamespace>Autotracker</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!-- Embed pjmembridge.dll for extraction at runtime (single-file publish) -->
  <ItemGroup>
    <None Include="$(ProjectDir)pjmembridge\pjmembridge.dll" Condition="Exists('$(ProjectDir)pjmembridge\pjmembridge.dll')" CopyToOutputDirectory="PreserveNewest" Link="pjmembridge.dll" />
  </ItemGroup>

  <!-- Copy xflag binary tables so MemoryPoller can compute bit positions at runtime -->
  <ItemGroup>
    <None Include="..\OoTMM\packages\generator\data\static\xflag_table_oot_scenes.bin" CopyToOutputDirectory="PreserveNewest" Link="xflag_table_oot_scenes.bin" />
    <None Include="..\OoTMM\packages\generator\data\static\xflag_table_oot_setups.bin" CopyToOutputDirectory="PreserveNewest" Link="xflag_table_oot_setups.bin" />
    <None Include="..\OoTMM\packages\generator\data\static\xflag_table_oot_rooms.bin" CopyToOutputDirectory="PreserveNewest" Link="xflag_table_oot_rooms.bin" />
    <None Include="..\OoTMM\packages\generator\data\static\xflag_table_mm_scenes.bin" CopyToOutputDirectory="PreserveNewest" Link="xflag_table_mm_scenes.bin" />
    <None Include="..\OoTMM\packages\generator\data\static\xflag_table_mm_setups.bin" CopyToOutputDirectory="PreserveNewest" Link="xflag_table_mm_setups.bin" />
    <None Include="..\OoTMM\packages\generator\data\static\xflag_table_mm_rooms.bin" CopyToOutputDirectory="PreserveNewest" Link="xflag_table_mm_rooms.bin" />
  </ItemGroup>

  <!-- Copy xflag-type-index.json so MemoryPoller can detect per-type xflag fields (pot, crate, grass...) -->
  <ItemGroup>
    <None Include="..\src\data\dist\xflag-type-index.json" CopyToOutputDirectory="PreserveNewest" Link="src\data\dist\xflag-type-index.json" />
  </ItemGroup>

</Project>
